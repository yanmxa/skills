# Local proxy credentials and private configuration
/.env

# Always ignore sensitive files even in tracked directories
**/*.key
**/*.pem
**/secrets.*
**/credentials.*
**/*_private.*
**/*_secret.*

# Debug and runtime files
cache/
paste-cache/
ide/
file-history/
projects/
shell-snapshots/
statsig/
todos/
history.jsonl
debug/
session-env
chrome
plans/*
telemetry
stats-cache.json
.vscode
.claude

# Personal settings and Claude Code's local plugin state
settings.json
settings.local.json
/plugins/
node_modules
bun.lock
transcripts
.opencode

# Personal config (not published as plugins)
/agents/
/backups/
/commands/
/hooks/
/package.json
/scripts/
/sessions/
/tasks/
/teams/

# Publish categorized skills; keep ad hoc top-level local skills private.
/skills/*
!/skills/engineering/
!/skills/misc/
!/skills/productivity/

__pycache__/
.DS_Store
